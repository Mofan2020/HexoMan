    "envDocs.pageTitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具链与运行环境"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolchain & Environment"
          }
        }
      }
    },
    "envDocs.pageSubtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里汇总了 HexoMan 用到的工具（Node、Git、Hexo）的安装方法和常见问题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install guides and FAQ for the tools HexoMan relies on (Node, Git, Hexo)."
          }
        }
      }
    },
    "envDocs.overview.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before You Start"
          }
        }
      }
    },
    "envDocs.overview.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 不自带任何运行时——它调用你系统里已经装好的 Node、npm、Git、Hexo。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan ships no runtime of its own — it calls the Node, npm, Git and Hexo you have installed on your system."
          }
        }
      }
    },
    "envDocs.overview.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要：Node.js 18 或更高 + Git。Hexo 不用手动装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need: Node.js 18 or later + Git. Hexo does not need to be installed manually."
          }
        }
      }
    },
    "envDocs.overview.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用 Homebrew 装 Node 和 Git；不想用 Homebrew 可以从官网下载官方安装包。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew is the recommended way to install Node and Git. Otherwise grab the official installers from the nodes.org / git-scm.com."
          }
        }
      }
    },
    "envDocs.overview.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装完点「重新检测」让 HexoMan 刷新工具链状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Re-check\" after installing so HexoMan refreshes the toolchain status."
          }
        }
      }
    },
    "envDocs.node.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js"
          }
        }
      }
    },
    "envDocs.node.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 靠 Node.js 跑 hexo 命令行工具。版本要求：18 或更高。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan needs Node.js to run the hexo CLI. Required: 18 or later."
          }
        }
      }
    },
    "envDocs.node.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 7+ 已经要求 Node 18，Hexo 8 也一样。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 7+ requires Node 18, so does Hexo 8."
          }
        }
      }
    },
    "envDocs.node.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装 Node 后 npm 会一起被装好，不用单独装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm is bundled with Node — no separate install needed."
          }
        }
      }
    },
    "envDocs.node.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GUI 程序（从 Dock 启动的 HexoMan）默认不会读 ~/.zshrc，所以 brew 装的 Node 在 HexoMan 里可能「找不到」。详见 Shell 环境章节。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GUI apps (HexoMan launched from the Dock) don't read ~/.zshrc by default — brew-installed Node can be \"missing\" inside HexoMan. See the Shell Environment section."
          }
        }
      }
    },
    "envDocs.node.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 会自动用临时目录装一份 hexo-cli，不污染你机器的全局 node_modules。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan auto-installs a hexo-cli copy under its own data dir — does not pollute your global node_modules."
          }
        }
      }
    },
    "envDocs.node.brew": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 装（推荐）："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew install (recommended):"
          }
        }
      }
    },

    "editor.insertImage.help": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the image into source/images and inserts Markdown — you can also drop an image onto the text or paste a screenshot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を source/images に保存して Markdown を挿入します。本文へのドラッグや、スクリーンショットの貼り付けも使えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把图片存进 source/images 并插入 Markdown；也可以直接把图片拖进正文，或粘贴截图"
          }
        }
      }
    },

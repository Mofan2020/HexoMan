    "theme.yun.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现代化三栏主题，亮暗双模式，配色可调，中文文档完善"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern 3-column theme, light & dark, customizable color, full Chinese docs"
          }
        }
      }
    },
    "theme.landscape.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 官方默认主题，四栏布局，稳不出错"

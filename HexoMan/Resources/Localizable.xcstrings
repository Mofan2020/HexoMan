    "envDocs.git.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git"
          }
        }
      }
    },
    "envDocs.git.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 不用 Git，但 HexoMan 的版本管理功能全靠 Git（提交、拉取、推送）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo itself doesn't use Git, but HexoMan's version control (commit, pull, push) relies on it."
          }
        }
      }
    },
    "envDocs.git.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 自带 Git：跑 `xcode-select --install` 就行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode ships Git: run `xcode-select --install`."
          }
        }
      }
    },
    "envDocs.git.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或者用 Homebrew 装更新版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or install a newer version via Homebrew."
          }
        }
      }
    },
    "envDocs.git.brew": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

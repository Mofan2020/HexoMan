    "envDocs.nvm.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多版本管理（nvm / fnm）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version Managers (nvm / fnm)"
          }

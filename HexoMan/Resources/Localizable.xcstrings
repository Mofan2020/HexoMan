  "sourceLanguage": "en",
  "strings": {
    "build.previewDrafts": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include drafts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览包含草稿"
          }
        }
      }
    },
    "build.previewDrafts.help": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds --draft to the preview command, so posts marked draft: true show up locally"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にするとプレビューに --draft が付き、draft: true の記事もローカルで表示されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后预览的命令行会带 --draft：front-matter 里 draft: true 的文章也能在本地预览里看到"
          }
        }
      }
    },
    "build.restart.drafts": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same for \"Include drafts\" — restart the preview to apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「下書きを含める」も同じで、プレビューを再起動すると反映されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「预览包含草稿」同理——改完重启预览才生效。"
          }
        }
      }
    },

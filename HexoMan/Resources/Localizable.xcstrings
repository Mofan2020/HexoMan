            "value": "Check version:"
          }
        }
      }
    },
    "envDocs.hexo.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo"
          }
        }
      }
    },
    "envDocs.hexo.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 不依赖全局 hexo 命令行——站点自带的 npm 依赖里有 hexo 就够用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan doesn't rely on a global hexo CLI — the hexo dependency in your site's node_modules is enough."
          }
        }
      }
    },
    "envDocs.hexo.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「创建新站点」时 HexoMan 会用你机器上的 npm 装一份 hexo-cli（装在 HexoMan 自带目录里）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When creating a new site, HexoMan installs a hexo-cli copy via your npm (under HexoMan's own data dir)."
          }
        }
      }
    },
    "envDocs.hexo.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「新建站点」成功后，新站点里会跑 npm install，hexo 进了站点本地 node_modules。从此 hexo 命令都走站点本地版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a successful site init, npm install pulls hexo into the site's local node_modules. From then on, hexo uses the local version."
          }
        }
      }
    },
    "envDocs.hexo.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有 node / npm，HexoMan 创建站点时会失败，提示要先装 Node.js。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If node / npm is missing, site creation fails with a hint to install Node.js first."
          }
        }
      }
    },
    "envDocs.hexo.installLocal": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点本地装 hexo："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install hexo locally to a site:"
          }
        }
      }
    },
    "envDocs.hexo.checkVersion": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查 hexo 版本（用站点本地依赖）："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check hexo version (uses the site's local dep):"
          }
        }
      }
    },
    "envDocs.shell.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell 环境（zsh 配置）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell Environment (zsh config)"
          }
        }
      }
    },
    "envDocs.shell.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 通过 ~/.zshenv / ~/.zprofile / ~/.zshrc 读你的 PATH。这一步缺失会导致「终端里能 hexo -v，HexoMan 里找不到 hexo」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan reads your PATH via ~/.zshenv / ~/.zprofile / ~/.zshrc. Missing this step is the cause of \"hexo -v works in terminal but HexoMan says it's missing\"."
          }
        }
      }
    },
    "envDocs.shell.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS GUI 应用不读 ~/.zshrc——这是 Apple 的设计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS GUI apps do not read ~/.zshrc — by Apple design."
          }
        }
      }
    },
    "envDocs.shell.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 在诊断页里点了「读取 zsh 配置」后会用 zsh -l -c 'echo $PATH' 启动一个登录 shell，拿到完整 PATH。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After enabling \"Read zsh configuration\" in Diagnostics, HexoMan starts a login shell via zsh -l -c to get the full PATH."
          }
        }
      }
    },
    "envDocs.shell.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 PATH 写在非标准 rc 文件（比如 .bashrc、.zshenv.local），到诊断页「zsh 配置文件路径」里手动指定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your PATH lives in a non-standard rc (e.g. .bashrc, .zshenv.local), point HexoMan to it via the \"zsh config file path\" field."
          }
        }
      }
    },
    "envDocs.shell.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH 不生效的常见原因：rc 文件只 export 给交互式 shell、brewinstall 的 prefix 路径拼错、zsh vs bash 混用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common reasons PATH doesn't take effect: rc only exports to interactive shell, brew prefix typo, mixing zsh and bash."
          }
        }
      }
    },
    "envDocs.troubleshoot.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疑难排查"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Troubleshooting"
          }
        }
      }
    },
    "envDocs.troubleshoot.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最常见的几个工具链问题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most common toolchain issues."
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「HexoMan 找不到 hexo」——勾选诊断页的「读取 zsh 配置」，或手动填 hexo 可执行文件路径。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"HexoMan can't find hexo\" — enable \"Read zsh configuration\" in Diagnostics, or set the hexo path manually."
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「node -v 在终端能跑，HexoMan 显示未找到」——同上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"node -v works in terminal, HexoMan says missing\" — same as above."
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「hexo 命令报 EACCES」——不要用 sudo 装全局包。用 Homebrew 装 Node，或用 nvm。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"hexo says EACCES\" — never sudo-install global packages. Use Homebrew or nvm."
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「生成的站点访问不了」——检查 _config.yml 的 url 字段。Hexo 不会自动填这个。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Generated site unreachable\" — check the url field in _config.yml. Hexo doesn't fill it automatically."
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet5": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「node 版本太老」——升级到 18+。HexoMan 会在诊断页给出警告。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Node too old\" — upgrade to 18+. HexoMan flags this in Diagnostics."
          }
        }
      }
    },
    "envDocs.troubleshoot.whichNode": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查 node 在哪："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate node:"
          }
        }
      }
    },
    "envDocs.troubleshoot.pathCheck": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查 PATH："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check PATH:"
          }
        }
      }
    },
    "envDocs.troubleshoot.zshrc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看 zsh 配置末尾："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect end of zsh config:"
          }
        }
      }
    },
    "envDocs.privacy.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私与网络访问"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Network Access"
          }
        }
      }
    },
    "envDocs.privacy.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 的默认承诺：不联网、不上传任何内容、不上传站点信息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan's default promise: no networking, no uploads, no site info shared."
          }
        }
      }
    },
    "envDocs.privacy.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭所有功能时，HexoMan 完全离线——所有命令都在本地跑、不连外网。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With everything disabled, HexoMan is fully offline — all commands run locally, no network calls."
          }
        }
      }
    },
    "envDocs.privacy.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题市场里如果用户主动开启了「联网补全」，HexoMan 会调 npm registry（registry.npmjs.org）只读搜索主题包。这一项默认关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the user enables \"online theme search\" in the theme market, HexoMan calls npm registry (registry.npmjs.org) read-only to search theme packages. This is off by default."
          }
        }
      }
    },
    "envDocs.privacy.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启联网后，HexoMan 在 NetworkAccessPolicy.plist 里声明了访问范围——Little Snitch 等工具会自动识别。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When online is enabled, NetworkAccessPolicy.plist declares the access scope — tools like Little Snitch recognize it automatically."
          }
        }
      }
    },
    "envDocs.privacy.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何「允许联网」的开关都会在设置项里显示，关闭后立即生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every network toggle is visible in Settings and takes effect immediately when turned off."
          }
        }
      }
    },
    "sidebar.environment": {

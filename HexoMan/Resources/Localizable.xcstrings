    "envDocs.git.xcode": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Command Line Tools:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode コマンドラインツール："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode CLT："
          }
        }
      }
    },
    "envDocs.hexo.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When creating a new site, HexoMan installs a hexo-cli copy via your npm (under HexoMan's own data dir)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規サイトを作るときに、HexoMan は npm を使って hexo-cli を用意します（HexoMan 専用のディレクトリ内）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「创建新站点」时 HexoMan 会用你机器上的 npm 装一份 hexo-cli（装在 HexoMan 自带目录里）。"
          }
        }
      }
    },
    "envDocs.hexo.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a successful site init, npm install pulls hexo into the site's local node_modules. From then on, hexo uses the local version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新規サイト」の作成に成功すると、そのサイトの中で npm install が実行され、hexo がサイトローカルの node_modules に入ります。あとは hexo コマンドが常にサイトのローカル版を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「新建站点」成功后，新站点里会跑 npm install，hexo 进了站点本地 node_modules。从此 hexo 命令都走站点本地版本。"
          }
        }
      }
    },
    "envDocs.hexo.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If node / npm is missing, site creation fails with a hint to install Node.js first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "node / npm がないと、サイトの作成は失敗し、先に Node.js を入れるよう案内します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有 node / npm，HexoMan 创建站点时会失败，提示要先装 Node.js。"
          }
        }
      }
    },
    "envDocs.hexo.checkVersion": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check hexo version (uses the site's local dep):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hexo のバージョンを確認（サイトローカルの依存を使用）："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查 hexo 版本（用站点本地依赖）："
          }
        }
      }
    },
    "envDocs.hexo.installLocal": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install hexo locally to a site:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hexo をサイトローカルに入れる："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点本地装 hexo："
          }
        }
      }
    },
    "envDocs.hexo.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan doesn't rely on a global hexo CLI — the hexo dependency in your site's node_modules is enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan はグローバルの hexo コマンドラインに依存しません。サイトの npm 依存関係に hexo が入っていれば十分です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 不依赖全局 hexo 命令行——站点自带的 npm 依赖里有 hexo 就够用。"
          }
        }
      }
    },
    "envDocs.hexo.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo"
          }
        }
      }
    },
    "envDocs.node.brew": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew install (recommended):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew でインストール（推奨）："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 装（推荐）："
          }
        }
      }
    },
    "envDocs.node.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 7+ requires Node 18, so does Hexo 8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 7 以降は Node 18 が必須で、Hexo 8 も同じです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 7+ 已经要求 Node 18，Hexo 8 也一样。"
          }
        }
      }
    },
    "envDocs.node.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm is bundled with Node — no separate install needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Node を入れると npm も一緒に入るので、個別にインストールする必要はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装 Node 后 npm 会一起被装好，不用单独装。"
          }
        }
      }
    },
    "envDocs.node.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GUI apps (HexoMan launched from the Dock) don't read ~/.zshrc by default — brew-installed Node can be \"missing\" inside HexoMan. See the Shell Environment section."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GUI アプリ（HexoMan を Dock から起動するもの）は既定で ~/.zshrc を読まないため、brew で入れた Node が「見つからない」ことがあります。シェルの環境についての章を参照してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GUI 程序（从 Dock 启动的 HexoMan）默认不会读 ~/.zshrc，所以 brew 装的 Node 在 HexoMan 里可能「找不到」。详见 Shell 环境章节。"
          }
        }
      }
    },
    "envDocs.node.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan auto-installs a hexo-cli copy under its own data dir — does not pollute your global node_modules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は一時ディレクトリに hexo-cli を自動で用意し、マシンのグローバル node_modules を汚しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 会自动用临时目录装一份 hexo-cli，不污染你机器的全局 node_modules。"
          }
        }
      }
    },

    "envDocs.pageSubtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里汇总了 HexoMan 用到的工具（Node、Git、Hexo）的安装方法和常见问题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install guides and FAQ for the tools HexoMan relies on (Node, Git, Hexo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan が使うツール（Node、Git、Hexo）のインストール方法とよくある質問をまとめています。"
          }
        }
      }
    },
    "envDocs.overview.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before You Start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる前に"
          }
        }
      }
    },
    "envDocs.overview.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 不自带任何运行时——它调用你系统里已经装好的 Node、npm、Git、Hexo。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan ships no runtime of its own — it calls the Node, npm, Git and Hexo you have installed on your system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は実行環境を一切同梱していません。すでにシステムにある Node、npm、Git、Hexo を呼び出して使います。"
          }
        }
      }
    },
    "envDocs.overview.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要：Node.js 18 或更高 + Git。Hexo 不用手动装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need: Node.js 18 or later + Git. Hexo does not need to be installed manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なもの：Node.js 18 以上と Git。Hexo は手動で入れる必要はありません。"
          }
        }
      }
    },
    "envDocs.overview.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用 Homebrew 装 Node 和 Git；不想用 Homebrew 可以从官网下载官方安装包。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew is the recommended way to install Node and Git. Otherwise grab the official installers from the nodes.org / git-scm.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Node と Git は Homebrew で入れるのがおすすめです。Homebrew を使わない場合は公式サイトからインストーラーを取得してください。"
          }
        }
      }
    },
    "envDocs.overview.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装完点「重新检测」让 HexoMan 刷新工具链状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Re-check\" after installing so HexoMan refreshes the toolchain status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール後に「再チェック」をクリックすると、HexoMan がツールチェーンの状態を更新します。"
          }
        }
      }
    },
    "envDocs.node.title": {

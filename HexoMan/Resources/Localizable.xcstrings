    "migrationSheet.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移公共项"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Migrate shared keys"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共通項目を移行"
          }
        }
      }
    },
    "migrationSheet.subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 到 %@：下列公共项在两边都有，可以把当前值搬到新主题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %@ to %@: the shared keys below exist in both. Carry over current values."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から %@ へ：以下の共通項目は両方に存在するので、現在の値を新しいテーマへ引き継げます。"
          }
        }
      }
    },
    "migrationSheet.note": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只勾你确认新主题也支持这些选项的项。错误地搬进去会让新主题加载失败。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only check items you know the new theme supports. Misapplying values can break the new theme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいテーマでも対応していると確認できた項目だけにチェックを入れてください。値を誤って移すと、新しいテーマの表示が壊れることがあります。"
          }
        }
      }
    },

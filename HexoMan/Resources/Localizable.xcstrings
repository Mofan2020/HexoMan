    "envDocs.node.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan needs Node.js to run the hexo CLI. Required: 18 or later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は hexo コマンドラインツールを動かすために Node.js を使います。18 以上が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 靠 Node.js 跑 hexo 命令行工具。版本要求：18 或更高。"
          }
        }
      }
    },

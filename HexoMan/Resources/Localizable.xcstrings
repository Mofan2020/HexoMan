    "themeView.browser.installHint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会用 npm 装包并切换当前主题。装完后会自动跑一次跨主题迁移（公共项搬运）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm install + switch the current theme. After install, runs a cross-theme migration for shared keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "npm でパッケージを入れて現在のテーマを切り替えます。完了後、共通項目の引き継ぎ（テーマ間の移行）が自動で実行されます。"
          }
        }
      }
    },
    "consentSheet.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络访问说明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network Access Disclosure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークアクセスの説明"
          }
        }
      }
    },
    "consentSheet.subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 想访问互联网来扩充主题市场"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan wants to access the internet to extend the theme market"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan がテーママーケットを拡充するためにインターネットへのアクセスを求めています"
          }
        }
      }
    },
    "consentSheet.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 仅访问 npm registry（registry.npmjs.org）来搜索 hexo-theme-* 主题包，全程只读、不上传、不传 Cookie，也不传站点信息。其他所有功能（命令执行、Git、文件读写）都完全离线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan only accesses the npm registry (registry.npmjs.org) to search for hexo-theme-* packages. Read-only, no uploads, no cookies, no site info shared. Everything else (shell, git, file IO) stays offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は hexo-theme-* パッケージの検索に npm レジストリ（registry.npmjs.org）へアクセスするだけです。読み取りのみで、アップロードも Cookie の送信もサイト情報の送信も行いません。ほかの機能（コマンド実行、Git、ファイル入出力）はすべてオフラインです。"
          }
        }
      }
    },
    "consentSheet.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机：registry.npmjs.org"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host: registry.npmjs.org"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト：registry.npmjs.org"
          }
        }
      }
    },
    "consentSheet.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据流向：仅 GET 包元数据（名称、版本、描述、官网、下载量）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data flow: GET package metadata only (name, version, description, homepage, downloads)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信するデータ：パッケージ情報の取得（名前、バージョン、説明、公式サイト、ダウンロード数）のみ"
          }
        }
      }
    },
    "consentSheet.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发时机：用户打开主题市场并搜索时；无后台轮询"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When: when you open the theme market and search; no background polling"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行される場面：テーママーケットを開いて検索したときのみ。バックグラウンドでの定期通信はありません"
          }
        }
      }
    },
    "consentSheet.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭路径：诊断页 →「允许联网补全主题库」开关"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to disable: Diagnostics page → \"Allow online theme search\" toggle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効化の方法：診断ページ →「テーマ一覧のオンライン補完を許可」のスイッチ"
          }
        }
      }
    },
    "consentSheet.dontAskAgain": {

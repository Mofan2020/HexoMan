      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        }
      }
    },
    "migrationSheet.apply": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用所选"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply Selected"
          }
        }

    "consentSheet.subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan wants to access the internet to extend the theme market"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan がテーママーケットを拡充するためにインターネットへのアクセスを求めています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 想访问互联网来扩充主题市场"
          }
        }
      }
    },
    "consentSheet.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {

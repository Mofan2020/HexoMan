    "theme.yun.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现代化三栏主题，亮暗双模式，配色可调，中文文档完善"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern 3-column theme, light & dark, customizable color, full Chinese docs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モダンな3カラムテーマ。ライトとダークの両方に対応し、配色を調整でき、中国語のドキュメントも整っています"
          }
        }
      }
    },
    "theme.landscape.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 官方默认主题，四栏布局，稳不出错"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo official default theme, 4-column layout, rock-solid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 公式のデフォルトテーマ。4カラム構成で、表示が安定しています"
          }
        }
      }
    },
    "theme.next.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能最全的主题，集成站内搜索、动态背景、多说等"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most feature-complete theme, integrated search, dynamic backgrounds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能が最も揃ったテーマ。サイト内検索、動的背景、多说などに対応"
          }
        }
      }
    },
    "theme.fluid.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fluid 风格，首页大图瀑布流，适合图片多的站"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fluid style, waterfall hero, ideal for image-heavy sites"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fluid スタイル。トップに並べる大きな画像が印象的で、写真の多いサイトに向いています"
          }
        }
      }
    },
    "theme.matery.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Material 风格，分类标签齐全，适合技术博客"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Material style, full tag/category support, ideal for tech blogs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Material スタイル。カテゴリとタグを網羅していて、技術ブログに向いています"
          }
        }
      }
    },

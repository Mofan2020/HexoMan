    "envDocs.git.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo itself doesn't use Git, but HexoMan's version control (commit, pull, push) relies on it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 自体は Git を使いませんが、HexoMan のバージョン管理機能（コミット、プル、プッシュ）はすべて Git に依存しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hexo 不用 Git，但 HexoMan 的版本管理功能全靠 Git（提交、拉取、推送）。"
          }
        }
      }
    },

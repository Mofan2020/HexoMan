          "stringUnit": {
            "state": "translated",
            "value": "Xcode ships Git: run `xcode-select --install`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode に付属している Git を使う：`xcode-select --install` を実行するだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 自带 Git：跑 `xcode-select --install` 就行。"
          }
        }

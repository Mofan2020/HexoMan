    "envDocs.nvm.aliasDefault": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set as default version:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトに設定："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为默认版本："
          }
        }
      }
    },
    "envDocs.nvm.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After nvm install, open a new terminal and `node -v` should work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "nvm を入れたあと、新しいターミナルを開いて `node -v` が使えることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "nvm 装完后新开一个终端，命令行 `node -v` 应该能用。"
          }
        }
      }
    },
    "envDocs.nvm.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nvm puts Node under ~/.nvm/versions/node/<v>/bin/node. HexoMan scans this automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "nvm は Node を ~/.nvm/versions/node/<v>/bin/node に置きます。HexoMan はこのディレクトリを自動的に走査します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "nvm 默认把 Node 装在 ~/.nvm/versions/node/<v>/bin/node。HexoMan 会自动扫这个目录。"
          }
        }
      }
    },
    "envDocs.nvm.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "fnm via Homebrew puts Node in a path HexoMan also detects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fnm を Homebrew 経由で入れた場合も、HexoMan は自動的に見つけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fnm 装在 Homebrew 路径下，HexoMan 也会自动找到。"
          }
        }
      }
    },
    "envDocs.nvm.install": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install nvm one-shot (modifies ~/.zshrc):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "nvm をまとめてインストール（スクリプトが ~/.zshrc を書き換えます）："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键装 nvm（脚本会改 ~/.zshrc）："
          }
        }
      }
    },
    "envDocs.nvm.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need multiple Node versions on the same machine, use nvm or fnm. HexoMan detects nvm-installed Node via /opt/homebrew/Cellar and ~/.nvm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じマシンで複数の Node バージョンを切り替えたいときは nvm や fnm を使ってください。HexoMan は ~/.nvm を通して nvm で入れた Node を検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一台机器要跑多个不同 Node 版本时用 nvm 或 fnm。HexoMan 通过 ~/.nvm 看 nvm 装的 Node。"
          }
        }
      }
    },
    "envDocs.nvm.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version Managers (nvm / fnm)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン管理（nvm / fnm）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多版本管理（nvm / fnm）"
          }
        }
      }
    },
    "envDocs.nvm.use": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the LTS release:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LTS をインストール："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装 LTS 版本："
          }
        }
      }
    },
    "envDocs.overview.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need: Node.js 18 or later + Git. Hexo does not need to be installed manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なもの：Node.js 18 以上と Git。Hexo は手動で入れる必要はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要：Node.js 18 或更高 + Git。Hexo 不用手动装。"
          }
        }
      }
    },
    "envDocs.overview.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew is the recommended way to install Node and Git. Otherwise grab the official installers from the nodes.org / git-scm.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Node と Git は Homebrew で入れるのがおすすめです。Homebrew を使わない場合は公式サイトからインストーラーを取得してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用 Homebrew 装 Node 和 Git；不想用 Homebrew 可以从官网下载官方安装包。"
          }
        }
      }
    },
    "envDocs.overview.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Re-check\" after installing so HexoMan refreshes the toolchain status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール後に「再チェック」をクリックすると、HexoMan がツールチェーンの状態を更新します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装完点「重新检测」让 HexoMan 刷新工具链状态。"
          }
        }
      }
    },
    "envDocs.overview.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan ships no runtime of its own — it calls the Node, npm, Git and Hexo you have installed on your system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は実行環境を一切同梱していません。すでにシステムにある Node、npm、Git、Hexo を呼び出して使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 不自带任何运行时——它调用你系统里已经装好的 Node、npm、Git、Hexo。"
          }
        }
      }
    },
    "envDocs.overview.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before You Start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる前に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前"
          }
        }
      }
    },
    "envDocs.pageSubtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install guides and FAQ for the tools HexoMan relies on (Node, Git, Hexo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan が使うツール（Node、Git、Hexo）のインストール方法とよくある質問をまとめています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里汇总了 HexoMan 用到的工具（Node、Git、Hexo）的安装方法和常见问题。"
          }
        }
      }
    },
    "envDocs.pageTitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolchain & Environment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールチェーンと実行環境"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具链与运行环境"
          }
        }
      }
    },
    "envDocs.privacy.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With everything disabled, HexoMan is fully offline — all commands run locally, no network calls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能を無効にした場合、HexoMan は完全にオフラインです。コマンドはすべてローカルで実行し、外部には接続しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭所有功能时，HexoMan 完全离线——所有命令都在本地跑、不连外网。"
          }
        }
      }
    },
    "envDocs.privacy.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the user enables \"online theme search\" in the theme market, HexoMan calls npm registry (registry.npmjs.org) read-only to search theme packages. This is off by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーママーケットで「オンライン補完」を有効にした場合、HexoMan は npm レジストリ（registry.npmjs.org）に読み取り専用で接続してテーマパッケージを検索します。既定では無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题市场里如果用户主动开启了「联网补全」，HexoMan 会调 npm registry（registry.npmjs.org）只读搜索主题包。这一项默认关。"
          }
        }
      }
    },
    "envDocs.privacy.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When online is enabled, NetworkAccessPolicy.plist declares the access scope — tools like Little Snitch recognize it automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインを有効にすると、HexoMan は NetworkAccessPolicy.plist でアクセス範囲を宣言します。Little Snitch などのツールが自動的に認識します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启联网后，HexoMan 在 NetworkAccessPolicy.plist 里声明了访问范围——Little Snitch 等工具会自动识别。"
          }
        }
      }
    },
    "envDocs.privacy.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every network toggle is visible in Settings and takes effect immediately when turned off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「オンラインを許可」のスイッチはすべて設定に表示され、無効にするとすぐ反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何「允许联网」的开关都会在设置项里显示，关闭后立即生效。"
          }
        }
      }
    },
    "envDocs.privacy.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan's default promise: no networking, no uploads, no site info shared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan の既定の約束：通信しない、何もアップロードしない、サイト情報を送信しない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 的默认承诺：不联网、不上传任何内容、不上传站点信息。"
          }
        }
      }
    },
    "envDocs.privacy.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Network Access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーとネットワークアクセス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私与网络访问"
          }
        }
      }
    },
    "envDocs.seeAlso": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See also"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連章"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关章节"
          }
        }
      }
    },
    "envDocs.shell.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS GUI apps do not read ~/.zshrc — by Apple design."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の GUI アプリは ~/.zshrc を読みません。これは Apple の設計によるものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS GUI 应用不读 ~/.zshrc——这是 Apple 的设计。"
          }
        }
      }
    },
    "envDocs.shell.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After enabling \"Read zsh configuration\" in Diagnostics, HexoMan starts a login shell via zsh -l -c to get the full PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は診断ページで「zsh 設定を読み込む」を有効にすると、`zsh -l -c 'echo $PATH'` でログインシェルを起動し、完全な PATH を取得します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 在诊断页里点了「读取 zsh 配置」后会用 zsh -l -c 'echo $PATH' 启动一个登录 shell，拿到完整 PATH。"
          }
        }
      }
    },
    "envDocs.shell.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your PATH lives in a non-standard rc (e.g. .bashrc, .zshenv.local), point HexoMan to it via the \"zsh config file path\" field."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH が標準以外の rc ファイル（.bashrc、.zshenv.local など）にある場合は、診断ページの「zsh 設定ファイルのパス」で指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 PATH 写在非标准 rc 文件（比如 .bashrc、.zshenv.local），到诊断页「zsh 配置文件路径」里手动指定。"
          }
        }
      }
    },
    "envDocs.shell.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common reasons PATH doesn't take effect: rc only exports to interactive shell, brew prefix typo, mixing zsh and bash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH が効かない主な原因：rc ファイルが対話シェルにだけ export している、brew の prefix パスの誤り、zsh と bash の混同。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH 不生效的常见原因：rc 文件只 export 给交互式 shell、brewinstall 的 prefix 路径拼错、zsh vs bash 混用。"
          }
        }
      }
    },
    "envDocs.shell.summary": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan reads your PATH via ~/.zshenv / ~/.zprofile / ~/.zshrc. Missing this step is the cause of \"hexo -v works in terminal but HexoMan says it's missing\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan は ~/.zshenv / ~/.zprofile / ~/.zshrc を通して PATH を読み取ります。ここが欠けると「ターミナルでは hexo -v が通るのに、HexoMan では hexo が見つからない」という症状になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HexoMan 通过 ~/.zshenv / ~/.zprofile / ~/.zshrc 读你的 PATH。这一步缺失会导致「终端里能 hexo -v，HexoMan 里找不到 hexo」。"
          }
        }
      }
    },
    "envDocs.shell.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell Environment (zsh config)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェル環境（zsh 設定）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell 环境（zsh 配置）"
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"HexoMan can't find hexo\" — enable \"Read zsh configuration\" in Diagnostics, or set the hexo path manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「HexoMan が hexo を見つけられない」—— 診断ページの「zsh 設定を読み込む」を有効にするか、hexo の実行ファイルのパスを直接指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「HexoMan 找不到 hexo」——勾选诊断页的「读取 zsh 配置」，或手动填 hexo 可执行文件路径。"
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"node -v works in terminal, HexoMan says missing\" — same as above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ターミナルでは node -v が動くのに HexoMan では見つからない」—— 上と同じです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「node -v 在终端能跑，HexoMan 显示未找到」——同上。"
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"hexo says EACCES\" — never sudo-install global packages. Use Homebrew or nvm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「hexo コマンドが EACCES エラーになる」—— sudo でグローバルパッケージを入れないでください。Homebrew か nvm で Node を入れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「hexo 命令报 EACCES」——不要用 sudo 装全局包。用 Homebrew 装 Node，或用 nvm。"
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Generated site unreachable\" — check the url field in _config.yml. Hexo doesn't fill it automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「生成したサイトを開けない」—— _config.yml の url フィールドを確認してください。Hexo はこの値を自動で埋めません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「生成的站点访问不了」——检查 _config.yml 的 url 字段。Hexo 不会自动填这个。"
          }
        }
      }
    },
    "envDocs.troubleshoot.bullet5": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Node too old\" — upgrade to 18+. HexoMan flags this in Diagnostics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Node のバージョンが古い」—— 18 以上に更新してください。HexoMan が診断ページで警告します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「node 版本太老」——升级到 18+。HexoMan 会在诊断页给出警告。"
          }
        }
      }
    },
    "envDocs.troubleshoot.pathCheck": {
